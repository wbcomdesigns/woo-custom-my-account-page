#: admin/partials/wcmp-faq.php:27
msgid "Q: How do I customize my WooCommerce My Account page?"
msgstr ""

#: admin/partials/wcmp-faq.php:28
msgid "A: Navigate to WooCommerce → Custom My Account Page → Endpoints tab. Here you can:"
msgstr ""

#: admin/partials/wcmp-faq.php:30
msgid "• Drag and drop to reorder menu items"
msgstr ""

#: admin/partials/wcmp-faq.php:31
msgid "• Show/hide endpoints using the power icon"
msgstr ""

#: admin/partials/wcmp-faq.php:32
msgid "• Click on an endpoint to edit its settings"
msgstr ""

#: admin/partials/wcmp-faq.php:33
msgid "• Use the buttons at the top to add groups, endpoints, or links"
msgstr ""

#: admin/partials/wcmp-faq.php:38
msgid "Q: What's the difference between Endpoints, Groups, and Links?"
msgstr ""

#: admin/partials/wcmp-faq.php:39
msgid "Endpoints:"
msgstr ""

#: admin/partials/wcmp-faq.php:39
msgid "These are pages within your My Account area (e.g., Orders, Downloads, Account Details). They display content on the same site."
msgstr ""

#: admin/partials/wcmp-faq.php:40
msgid "Groups:"
msgstr ""

#: admin/partials/wcmp-faq.php:40
msgid "Organize multiple endpoints together under a collapsible menu. Perfect for grouping related items like \"My Purchases\" (Orders + Downloads)."
msgstr ""

#: admin/partials/wcmp-faq.php:41
msgid "Links:"
msgstr ""

#: admin/partials/wcmp-faq.php:41
msgid "Add external or internal links to your menu (e.g., Support page, Blog, FAQs). They can open in the same tab or a new tab."
msgstr ""

#: admin/partials/wcmp-faq.php:46
msgid "Creating & Managing Items"
msgstr ""

#: admin/partials/wcmp-faq.php:49
msgid "Q: How do I create a new custom endpoint?"
msgstr ""

#: admin/partials/wcmp-faq.php:51
msgid "Go to Endpoints tab"
msgstr ""

#: admin/partials/wcmp-faq.php:52
msgid "Click \"Add endpoint\" button"
msgstr ""

#: admin/partials/wcmp-faq.php:53
msgid "Enter a name (e.g., \"Wishlist\")"
msgstr ""

#: admin/partials/wcmp-faq.php:54
msgid "Click \"Add\" and configure the settings:"
msgstr ""

#: admin/partials/wcmp-faq.php:57
msgid "• Endpoint slug: URL-friendly version (e.g., wishlist)"
msgstr ""

#: admin/partials/wcmp-faq.php:58
msgid "• Label: Display name in the menu"
msgstr ""

#: admin/partials/wcmp-faq.php:59
msgid "• Icon: FontAwesome class (e.g., fa fa-heart)"
msgstr ""

#: admin/partials/wcmp-faq.php:60
msgid "• Content: Custom HTML/shortcode for the page"
msgstr ""

#: admin/partials/wcmp-faq.php:63
msgid "Click \"Save Changes\""
msgstr ""

#: admin/partials/wcmp-faq.php:68
msgid "Q: How do I create a group with sub-items?"
msgstr ""

#: admin/partials/wcmp-faq.php:70
msgid "Click \"Add group\" button"
msgstr ""

#: admin/partials/wcmp-faq.php:71
msgid "Enter a name (e.g., \"My Purchases\")"
msgstr ""

#: admin/partials/wcmp-faq.php:72
msgid "Drag and drop existing endpoints INTO the group area"
msgstr ""

#: admin/partials/wcmp-faq.php:73
msgid "The group will now show a dropdown arrow with sub-items"
msgstr ""

#: admin/partials/wcmp-faq.php:74
#: admin/partials/wcmp-faq.php:91
msgid "Save your changes"
msgstr ""

#: admin/partials/wcmp-faq.php:79
msgid "Q: How do I add an external link to the menu?"
msgstr ""

#: admin/partials/wcmp-faq.php:81
msgid "Click \"Add link\" button"
msgstr ""

#: admin/partials/wcmp-faq.php:82
msgid "Enter a name (e.g., \"Support\")"
msgstr ""

#: admin/partials/wcmp-faq.php:83
msgid "Configure the link settings:"
msgstr ""

#: admin/partials/wcmp-faq.php:86
msgid "• Link URL: Full URL (e.g., https://example.com/support)"
msgstr ""

#: admin/partials/wcmp-faq.php:87
msgid "• Link label: Display text"
msgstr ""

#: admin/partials/wcmp-faq.php:88
msgid "• Open in new tab: Check to open externally"
msgstr ""

#: admin/partials/wcmp-faq.php:96
msgid "Q: How do I reorder menu items?"
msgstr ""

#: admin/partials/wcmp-faq.php:97
msgid "A: Simply drag and drop items to rearrange them. The order you see in the admin panel is the order customers will see on the frontend. Don't forget to click \"Save Changes\" to apply your new order."
msgstr ""

#: admin/partials/wcmp-faq.php:101
msgid "Q: How do I remove an endpoint?"
msgstr ""

#: admin/partials/wcmp-faq.php:102
msgid "A: Click on the endpoint to expand it, then click the \"Remove\" link. This will delete it from your menu. Note: You can also just hide it using the power icon if you want to keep it for later."
msgstr ""

#: admin/partials/wcmp-faq.php:107
msgid "Customization Options"
msgstr ""

#: admin/partials/wcmp-faq.php:110
msgid "Q: How do I add icons to menu items?"
msgstr ""

#: admin/partials/wcmp-faq.php:111
msgid "A: This plugin uses FontAwesome 4.7 icons. To add an icon:"
msgstr ""

#: admin/partials/wcmp-faq.php:113
msgid "Type an icon name from the bundled set (e.g. fa-tag, fa-heart, fa-user) - the picker previews exactly what members will see"
