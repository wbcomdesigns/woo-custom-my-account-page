#: admin/partials/wcmp-faq.php:115
msgid "Copy the class name (e.g., \"fa fa-shopping-cart\")"
msgstr ""

#: admin/partials/wcmp-faq.php:116
msgid "Paste it into the \"Icon\" field of your endpoint"
msgstr ""

#: admin/partials/wcmp-faq.php:118
msgid "Popular icons:"
msgstr ""

#: admin/partials/wcmp-faq.php:120
msgid "• fa fa-user (user profile)"
msgstr ""

#: admin/partials/wcmp-faq.php:121
msgid "• fa fa-shopping-cart (orders)"
msgstr ""

#: admin/partials/wcmp-faq.php:122
msgid "• fa fa-download (downloads)"
